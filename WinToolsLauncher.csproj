<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinToolsLauncher</RootNamespace>
    <AssemblyName>WinToolsLauncher</AssemblyName>

    <!-- 指定生成的 .exe 软件主图标 -->
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>

    <!-- 优化：不生成 pdb 调试符号文件，生成干净的单文件 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="Exists('app.ico')">
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
