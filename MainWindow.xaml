<Window x:Class="WinToolsLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 系统工具快捷打开器" Height="460" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="点击下方按钮快速打开系统设置：" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <UniformGrid Grid.Row="1" Columns="3" Rows="5">
            <Button Content="控制面板" Margin="4" Click="BtnControlPanel_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="设备和打印机" Margin="4" Click="BtnPrinters_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="网络连接" Margin="4" Click="BtnNetwork_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="设备管理器" Margin="4" Click="BtnDevMgmt_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="声音控制面板" Margin="4" Click="BtnSound_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="电源选项 (经典)" Margin="4" Click="BtnPower_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="高级防火墙" Margin="4" Click="BtnFirewall_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="计算机管理" Margin="4" Click="BtnCompMgmt_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="组策略编辑器" Margin="4" Click="BtnGroupPolicy_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="BitLocker 加密" Margin="4" Click="BtnBitLocker_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="程序和功能 (卸载)" Margin="4" Click="BtnAppWiz_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="远程桌面" Margin="4" Click="BtnRdp_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="系统属性 (环境变量)" Margin="4" Click="BtnSysDm_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="服务管理" Margin="4" Click="BtnServices_Click" Background="#E1E1E1" FontSize="13"/>
            <Button Content="任务管理器" Margin="4" Click="BtnTaskMgr_Click" Background="#E1E1E1" FontSize="13"/>
        </UniformGrid>
    </Grid>
</Window>
